{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "chromium:manifest_version": 3,
  "firefox:manifest_version": 2,
  "version": "1.0.0",
  "name": "CrackDial",
  "description": "Replaces the browser's new tab page with Kagi search and speed dials.",
  "icons": {
    "16": "images/icon.png",
    "32": "images/icon.png",
    "48": "images/icon.png",
    "64": "images/icon.png",
    "128": "images/icon.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab/index.html"
  },
  "chromium:permissions": [
    "storage",
    "geolocation"
  ],
  "chromium:host_permissions": [
    "<all_urls>"
  ],
  "firefox:permissions": [
    "storage",
    "geolocation",
    "<all_urls>"
  ],
  "author": "Emma Lejeck"
}
